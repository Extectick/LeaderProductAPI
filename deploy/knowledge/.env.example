# Local-only bootstrap. Configure the public hostname after DNS and TLS are ready.
NEXTCLOUD_IMAGE=nextcloud:34.0.5-apache@sha256:e881320833451d8320727d7e20386c39021d51ba03bbb1e153ddfeb114ce6145
POSTGRES_IMAGE=postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
REDIS_IMAGE=redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
NEXTCLOUD_PORT=18120
NEXTCLOUD_ADMIN_USER=knowledge-admin
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1"
NEXTCLOUD_BASE_URL=http://localhost:18120
# For the public proxy only: set its actual Docker gateway address, not all private networks.
NEXTCLOUD_TRUSTED_PROXIES=
