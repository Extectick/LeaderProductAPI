[Unit]
Description=Private backup of the knowledge portal on server 126
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=extectick
Group=extectick
SupplementaryGroups=docker
WorkingDirectory=/opt/leader-knowledge-126
UMask=0077
ExecStart=/usr/bin/python3 /opt/leader-knowledge-126/backup-local-126.py
TimeoutStartSec=1200
