[Unit]
Description=Renew the knowledge portal LAN certificate
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=extectick
Group=extectick
SupplementaryGroups=docker
WorkingDirectory=/opt/leader-knowledge-126
UMask=0077
ExecStart=/usr/bin/python3 /opt/leader-knowledge-126/renew-local-126.py
