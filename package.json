{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon --watch src/**/*.ts --exec ts-node src/index.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --ext ts,json --exec \"node -r ts-node/register/transpile-only src/index.ts\"",
    "prisma": "prisma",
    "prisma:generate": "node --env-file=.env.dev node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=.env.dev node_modules/prisma/build/index.js migrate deploy",
    "studio": "node scripts/run-prisma-studio.js",
    "prisma:seed": "node --env-file=.env.dev node_modules/ts-node/dist/bin.js --transpile-only src/prisma/seed.ts",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.unit.config.ts",
    "test:help-quality": "cross-env NODE_ENV=test jest --config jest.unit.config.ts --runInBand --testPathPatterns=\"help\\.(openai|context|chat-context|answer|handoff-context|app-api|app-readback|tool-outcome|it-lifecycle|analysis-evidence|quality-evaluation|office|it-brief|performance|ai-progress|assistant-scheduler)\"",
    "test:help-openai": "cross-env NODE_ENV=test jest --config jest.unit.config.ts --runInBand --runTestsByPath __tests__/help.openai.unit.test.ts __tests__/help.assistant-lease.unit.test.ts __tests__/help.knowledge.unit.test.ts __tests__/help.assistant-delivery.unit.test.ts",
    "test:help-openai:flow": "node __tests__/help.openai-flow.integration.qa.cjs",
    "eval:help-search": "node scripts/evaluate-help-search.cjs",
    "test:integration": "cross-env NODE_ENV=test TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/LeaderAPI_test?schema=public TEST_REDIS_URL=redis://127.0.0.1:6389 jest --config jest.config.ts",
    "test:integration:db:up": "docker compose -p leaderproductapi-test -f docker-compose.test.yml up -d test-postgres test-redis test-minio",
    "test:integration:db:down": "docker compose -p leaderproductapi-test -f docker-compose.test.yml down -v",
    "test:integration:docker": "node scripts/run-integration-tests.js",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/prisma/seed.ts",
    "updates:publish-apk-db": "node scripts/publish-apk-update-db.js",
    "ota:publish-db": "node scripts/publish-ota-update-db.js",
    "audit:employee-moderation": "node scripts/audit-employee-moderation-consistency.js",
    "fix:employee-moderation": "node scripts/fix-employee-moderation-consistency.js",
    "fix:employee-moderation:apply": "node scripts/fix-employee-moderation-consistency.js --apply",
    "worker:knowledge": "node dist/workers/knowledgeWorker.js",
    "worker:knowledge:dev": "node -r ts-node/register src/workers/knowledgeWorker.ts",
    "worker:help": "node dist/workers/helpAssistantWorker.js",
    "worker:help:dev": "node -r ts-node/register src/workers/helpAssistantWorker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@json2csv/plainjs": "^7.0.8",
    "@maxhub/max-bot-api": "1.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tma.js/init-data-node": "^2.0.8",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "css-tree": "3.2.1",
    "docx": "9.15.2",
    "dotenv": "^18.0.9",
    "exceljs": "4.4.0",
    "expo-server-sdk": "^8.0.0",
    "express": "^5.3.0",
    "fast-geoip": "^1.1.88",
    "fast-xml-parser": "5.12.0",
    "htmlparser2": "12.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mammoth": "1.13.0",
    "mime-types": "^3.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-parse": "2.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^6.3.1",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "ua-parser-js": "^2.0.10",
    "undici": "^7.30.1",
    "validator": "^13.15.35",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/css-tree": "3.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "glob": "14.0.3"
  }
}
